{
  "name": "unblock",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "db:local": "wrangler d1 migrations apply unblock --local",
    "db:remote": "wrangler d1 migrations apply unblock --remote",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "seed": "wrangler d1 execute unblock --local --file scripts/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
