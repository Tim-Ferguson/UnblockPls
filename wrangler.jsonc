{
  "name": "unblock",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Files in public/ are served directly; everything else falls through to the Worker.
  "assets": { "directory": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unblock",
      "database_id": "88c3d7d6-bf10-4526-8736-76ce1978be7a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Custom domain: Cloudflare creates the DNS record and certificate for this hostname.
  "routes": [{ "pattern": "unblock.timo.gg", "custom_domain": true }],
  // Hide the *.workers.dev and preview URLs so the site has one address (matters for sign-in callbacks).
  "workers_dev": false,
  "preview_urls": false
}
